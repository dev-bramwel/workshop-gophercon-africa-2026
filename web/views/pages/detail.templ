package pages

import (
	"cmp"
	"fmt"
	"strconv"
	"workshop/internal/domain/sighting"
	"workshop/web/views/components"
	"workshop/web/views/layout"
)

templ SightingDetail(s sighting.Sighting) {
	@layout.Base(layout.BaseProps{Title: Name(s.Species), Active: "/sightings"}) {
		<a href="/sightings" class="back-link">
			@components.Icon("back")
			Back to sightings
		</a>
		<div class="page-heading detail-heading">
			<div>
				<p class="eyebrow">A MOMENT IN THE WILD</p>
				<h1>
					{ Name(s.Species) }
					<span class="accent-dot">.</span>
				</h1>
				<p class="page-description scientific">
					{ Scientific(s.Species) }
				</p>
			</div>
			<a href={ templ.URL(AnimalURL(s.Species)) } class="button button-light">
				Get to know this animal
				@components.Icon("arrow-up")
			</a>
		</div>
		<div class="detail-grid">
			<section>
				<div class="detail-photo" data-tilt>
					@PhotoImage(s)
					<span class="detail-photo-label">
						@components.Icon("pin")
						<span>{ s.Location.Country }</span>
					</span>
				</div>
				@PhotoAttribution(s)
				<div class="panel observation-panel">
					<p class="eyebrow">THE FIELD NOTES</p>
					<h2>About this encounter</h2>
					<dl class="detail-meta">
						<div>
							<dt>
								@components.Icon("calendar")
								Observed on
							</dt>
							<dd>
								{ Date(s) }
							</dd>
						</div>
						<div>
							<dt>
								@components.Icon("pin")
								Location
							</dt>
							<dd>
								{ Place(s.Location) }
							</dd>
						</div>
						<div>
							<dt>
								@components.Icon("compass")
								Recorded by
							</dt>
							<dd>
								{ cmp.Or(s.RecordedBy,"Observer not recorded") }
							</dd>
						</div>
						<div>
							<dt>
								@components.Icon("leaf")
								Individuals
							</dt>
							<dd>
								if s.IndividualCount!=nil {
									{ *s.IndividualCount }
								} else {
									<span>Not recorded</span>
								}
							</dd>
						</div>
						<div>
							<dt>Coordinates</dt>
							<dd>
								{ fmt.Sprintf("%.5f, %.5f",s.Location.Latitude,s.Location.Longitude) }
							</dd>
						</div>
						if s.Location.CoordinateUncertaintyInMetres!=nil {
							<div>
								<dt>Coordinate uncertainty</dt>
								<dd>
									{ fmt.Sprintf("± %.0f metres",*s.Location.CoordinateUncertaintyInMetres) }
								</dd>
							</div>
						}
						if s.BasisOfRecord!="" {
							<div>
								<dt>Record type</dt>
								<dd>
									{ s.BasisOfRecord }
								</dd>
							</div>
						}
					</dl>
					if s.Remarks!="" {
						<div class="observation-remarks">
							<h3>Observer’s notes</h3>
							<p>
								{ s.Remarks }
							</p>
						</div>
					}
					<a class="text-link" href={ templ.URL("https://www.gbif.org/occurrence/" + strconv.FormatInt(s.GBIFKey, 10)) } target="_blank" rel="noopener noreferrer">
						View original GBIF record
						@components.Icon("arrow-up")
					</a>
				</div>
			</section>
			<aside class="detail-sidebar">
				@WeatherPanel(s)
				<section class="panel detail-map">
					<div class="panel-heading">
						<div>
							<p class="eyebrow">THE PLACE</p>
							<h2>Out in the world</h2>
						</div>
						@components.Icon("map")
					</div>
					@SightingMap([]sighting.Sighting{s}, "detail-map")
					<p class="map-place">
						{ Place(s.Location) }
					</p>
				</section>
				<a class="animal-guide-link" href={ templ.URL(AnimalURL(s.Species)) }>
					@components.Icon("spark")
					<span>
						<strong>There’s more to this animal.</strong>
						<span>Discover its story and surprising facts.</span>
					</span>
					@components.Icon("arrow")
				</a>
			</aside>
		</div>
		<section class="photo-section" id="photo-credits">
			<div class="section-heading">
				<div>
					<p class="eyebrow">THROUGH THE OBSERVER’S LENS</p>
					<h2>More from this encounter</h2>
				</div>
			</div>
			<div class="photo-gallery">
				for _,m:=range s.Media {
					if IsPhoto(m) {
						<figure>
							<a href={ templ.URL(m.URL) } target="_blank" rel="noopener noreferrer">
								<img src={ m.URL } alt={ cmp.Or(m.Title, Name(s.Species)+" observation photo") } loading="lazy"/>
								<span class="photo-expand">Open photo ↗</span>
							</a>
							<figcaption>
								{ cmp.Or(m.Creator,m.RightsHolder,"Photographer not recorded") }
								if m.License!="" {
									<a href={ templ.URL(m.License) } target="_blank" rel="noopener noreferrer">Photo licence ↗</a>
								}
							</figcaption>
						</figure>
					}
				}
			</div>
			if Photo(s)=="" {
				<p class="muted">No photographs were attached to this observation.</p>
			}
		</section>
	}
}

templ WeatherPanel(s sighting.Sighting) {
	<section class="weather-panel">
		<p class="eyebrow">AT THE TIME OF THE SIGHTING</p>
		<div class="weather-main">
			@components.Icon("sun")
			if s.Weather.ObservedAt.IsZero() {
				<h2>Weather unavailable</h2>
			} else {
				<strong>
					{ fmt.Sprintf("%.0f",s.Weather.Temperature.Actual) }
					<span>°C</span>
				</strong>
			}
		</div>
		if !s.Weather.ObservedAt.IsZero() {
			<h3>
				{ cmp.Or(s.Weather.Condition.Description,"Conditions recorded") }
			</h3>
			<p class="weather-feels">
				Feels like { fmt.Sprintf("%.0f°C",s.Weather.Temperature.Apparent) }
			</p>
			<div class="weather-details">
				<div>
					@components.Icon("wind")
					<span>
						Wind
						<strong>
							{ fmt.Sprintf("%.1f km/h",s.Weather.Wind.Speed) }
						</strong>
					</span>
				</div>
				<div>
					@components.Icon("drop")
					<span>
						Humidity<strong>{ s.Weather.Humidity }%</strong>
					</span>
				</div>
				<div>
					@components.Icon("drop")
					<span>
						Precipitation
						<strong>
							{ fmt.Sprintf("%.1f mm",s.Weather.Precipitation.Total) }
						</strong>
					</span>
				</div>
			</div>
			<p class="weather-source">
				Historical conditions · Open-Meteo
				<br/>
				{ s.Weather.ObservedAt.Format("02 Jan 2006 · 15:04 MST") }
			</p>
		} else {
			<p>Historical weather has not been recorded for this observation.</p>
		}
	</section>
}

templ AnimalDetail(a AnimalCard, d Collection) {
	@layout.Base(layout.BaseProps{Title: Name(a.Species), Active: "/gallery"}) {
		<a href="/gallery" class="back-link">
			@components.Icon("back")
			Back to animal gallery
		</a>
		<section class="animal-hero">
			<div class="animal-hero-copy">
				<p class="eyebrow">THE WILD, UP CLOSE</p>
				<h1>
					{ Name(a.Species) }
					<span class="accent-dot">.</span>
				</h1>
				<p class="scientific">
					{ Scientific(a.Species) }
				</p>
				<p class="animal-intro">A remarkable neighbour on a remarkable planet.<br/>Get to know the animal behind the observations.</p>
				<div class="animal-hero-stats">
					<div>
						<strong>
							{ a.Count }
						</strong>
						<span>recorded sightings</span>
					</div>
					<div>
						<strong>
							{ d.Summary.Countries }
						</strong>
						<span>countries in our journal</span>
					</div>
				</div>
				<a href={ templ.URL(d.Link("/sightings", 1)) } class="button button-green">
					Explore its sightings
					@components.Icon("arrow")
				</a>
			</div>
			<div class="animal-portrait" data-tilt>
				<div class="portrait-orbit" aria-hidden="true"></div>
				<div class="portrait-image">
					@PhotoImage(a.Sighting)
				</div>
				<span class="portrait-label">A closer look. A new perspective.</span>
				<span class="portrait-cross" aria-hidden="true">+</span>
			</div>
		</section>
		@PhotoAttribution(a.Sighting)
		<section class="facts-section">
			<div class="section-heading">
				<div>
					<p class="eyebrow">A LITTLE LESS ORDINARY</p>
					<h2>Did you know?</h2>
				</div>
				<span class="facts-badge">
					@components.Icon("spark")
					Feed your curiosity
				</span>
			</div>
			<div class="facts-grid">
				for i,f:=range AnimalFacts(a) {
					<article class="fact-card" data-tilt>
						<span class="fact-number">
							{ fmt.Sprintf("%02d",i+1) }
						</span>
						@components.Icon("spark")
						<h3>
							{ f.Title }
						</h3>
						<p>
							{ f.Text }
						</p>
						<a href={ templ.URL(f.Source) } class="fact-source" target="_blank" rel="noopener noreferrer">{ f.SourceName } ↗</a>
					</article>
				}
			</div>
		</section>
		<div class="animal-details-grid">
			<section class="panel taxonomy">
				<div class="panel-heading">
					<div>
						<p class="eyebrow">CONNECTED BY NATURE</p>
						<h2>A place in the animal kingdom</h2>
					</div>
					@components.Icon("leaf")
				</div>
				<dl>
					for _,o:=range taxonomy(a) {
						if o.Value!="" {
							<div>
								<dt>
									{ o.Label }
								</dt>
								<dd>
									{ o.Value }
								</dd>
							</div>
						}
					}
				</dl>
				<a href={ templ.URL(GBIF(a.Species)) } target="_blank" rel="noopener noreferrer" class="text-link">
					Explore GBIF taxonomy
					@components.Icon("arrow-up")
				</a>
			</section>
			<section class="panel animal-range">
				<div class="panel-heading">
					<div>
						<p class="eyebrow">FOLLOW THE FOOTPRINTS</p>
						<h2>Where it’s been observed</h2>
						<p>Locations in our journal; not a complete species range.</p>
					</div>
				</div>
				@SightingMap(d.Items, "animal-map")
			</section>
		</div>
		<section class="animal-sightings">
			<div class="section-heading">
				<div>
					<p class="eyebrow">MORE THAN A NAME</p>
					<h2>
						Encounters with { Name(a.Species) }
					</h2>
				</div>
				<a class="text-link" href={ templ.URL(d.Link("/sightings", 1)) }>
					All sightings
					@components.Icon("arrow")
				</a>
			</div>
			<div class="sighting-grid">
				for _,s:=range d.Recent() {
					@SightingTile(s)
				}
			</div>
		</section>
	}
}

func taxonomy(a AnimalCard) []Option {
	s := a.Species
	return []Option{{s.Kingdom, "Kingdom"}, {s.Phylum, "Phylum"}, {s.Class, "Class"}, {s.Order, "Order"}, {s.Family, "Family"}, {s.Genus, "Genus"}, {cmp.Or(s.CanonicalName, s.Species), "Species"}}
}

templ PhotoAttribution(s sighting.Sighting) {
	if Photo(s)!="" {
		<p class="image-credit">
			<span>
				{ "Photo: "+PhotoCredit(s) } ·
				if CoverMedia(s).License!="" {
					<a href={ templ.URL(CoverMedia(s).License) } target="_blank" rel="noopener noreferrer">{ LicenseName(CoverMedia(s).License) }</a>
				} else {
					<span>Licence not recorded</span>
				}
			</span>
			<a href={ templ.URL(CoverMedia(s).URL) } target="_blank" rel="noopener noreferrer">Original photo ↗</a>
			<span>Cropped for display.</span>
		</p>
	}
}
