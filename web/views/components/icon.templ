package components

templ Icon(name string) {
	<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={ iconPath(name) }></path></svg>
}

func iconPath(name string) string {
	switch name {
	case "dashboard":
		return "M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z"
	case "compass":
		return "M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20 M16 8l-2 6-6 2 2-6z"
	case "map":
		return "M3 5l6-3 6 3 6-3v17l-6 3-6-3-6 3z M9 2v17 M15 5v17"
	case "gallery":
		return "M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1 M3 16l5-5 5 5 3-3 5 5 M15 7h.01"
	case "chart":
		return "M4 3v18h17 M8 16v-5 M13 16V7 M18 16V4"
	case "arrow":
		return "M5 12h14 M13 6l6 6-6 6"
	case "arrow-up":
		return "M7 17L17 7 M7 7h10v10"
	case "pin":
		return "M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0 M15 10a3 3 0 1 1-6 0 3 3 0 0 1 6 0"
	case "search":
		return "M21 21l-5-5 M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0"
	case "sun":
		return "M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0 M12 2v2 M12 20v2 M2 12h2 M20 12h2 M5 5l1.5 1.5 M17.5 17.5L19 19 M5 19l1.5-1.5 M17.5 6.5L19 5"
	case "globe":
		return "M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0 M2 12h20 M12 2c6 6 6 14 0 20-6-6-6-14 0-20"
	case "leaf":
		return "M20 3C9 1 2 7 4 14s11 10 16-11 M5 20L16 8"
	case "camera":
		return "M3 7h4l2-3h6l2 3h4v13H3z M16 13a4 4 0 1 1-8 0 4 4 0 0 1 8 0"
	case "calendar":
		return "M4 5h16v16H4z M8 2v6 M16 2v6 M4 11h16"
	case "wind":
		return "M3 8h12c5 0 5-6 1-6 M3 12h16c4 0 4 6 0 6 M3 16h7c4 0 4 5 0 5"
	case "drop":
		return "M12 2S5 10 5 15a7 7 0 0 0 14 0c0-5-7-13-7-13"
	case "back":
		return "M19 12H5 M11 6l-6 6 6 6"
	case "spark":
		return "M12 2l3 7 7 3-7 3-3 7-3-7-7-3 7-3z"
	case "check":
		return "M5 12l4 4L19 6"
	case "pause":
		return "M8 5v14 M16 5v14"
	default:
		return "M12 3v18 M3 12h18"
	}
}
